    {
      "parameters": {
        "jsCode": "const raw=$json.content?.parts?.[0]?.text ?? $json.output ?? $json.text ?? $json.response ?? \"\"; if(!raw) throw new Error(\"AI model returned no usable output.\"); let ai; if(typeof raw===\"object\") ai=raw; else { const s=String(raw).replace(/^```json\\s*/i,\"\").replace(/^```\\s*/i,\"\").replace(/\\s*```$/i,\"\").trim(); try{ai=JSON.parse(s)}catch{throw new Error(\"AI returned invalid JSON.\")} } const allowed=[\"GREETING\",\"PRODUCT_AVAILABILITY\",\"PRICE_ENQUIRY\",\"PLACE_ORDER\",\"ORDER_STATUS\",\"COMPLAINT\",\"UNKNOWN\"]; if(!allowed.includes(ai.intent)) ai.intent=\"UNKNOWN\"; ai.confidence=Math.max(0,Math.min(1,Number(ai.confidence)||0)); return {json:{...$json,ai}};"
      },
