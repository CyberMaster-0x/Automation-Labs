    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS public.products (\n    id SERIAL PRIMARY KEY,\n    product_name VARCHAR(150) NOT NULL,\n    sku VARCHAR(50) UNIQUE NOT NULL,\n    price NUMERIC(12,2) NOT NULL,\n    stock_quantity INTEGER NOT NULL DEFAULT 0,\n    category VARCHAR(100),\n    active BOOLEAN DEFAULT TRUE,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE IF NOT EXISTS public.orders (\n    id SERIAL PRIMARY KEY,\n    order_reference VARCHAR(50) UNIQUE NOT NULL,\n    customer_phone VARCHAR(30) NOT NULL,\n    customer_name VARCHAR(100),\n    product_sku VARCHAR(50) NOT NULL,\n    quantity INTEGER NOT NULL,\n    total_amount NUMERIC(12,2) NOT NULL,\n    status VARCHAR(30) NOT NULL DEFAULT 'PROCESSING',\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE IF NOT EXISTS public.automation_logs (\n    id SERIAL PRIMARY KEY,\n    request_id VARCHAR(100),\n    customer_phone VARCHAR(30),\n    intent VARCHAR(50),\n    confidence NUMERIC(4,3),\n    status VARCHAR(50),\n    action_taken VARCHAR(100),\n    error_message TEXT,\n    raw_input JSONB,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nINSERT INTO public.products\n(product_name, sku, price, stock_quantity, category)\nVALUES\n('Oraimo Power Bank', 'OR-PB-001', 25000, 15, 'Power Banks'),\n('Oraimo FreePods 4', 'OR-FP-004', 45000, 8, 'Earbuds'),\n('Samsung Galaxy A15', 'SAM-A15-001', 285000, 5, 'Smartphones'),\n('Anker PowerCore 20000', 'ANK-PC-20000', 38000, 12, 'Power Banks'),\n('Oraimo Watch 5', 'OR-W5-001', 35000, 0, 'Smart Watches'),\n('HP EliteBook 840', 'HP-EB-840', 650000, 3, 'Laptops')\nON CONFLICT (sku) DO NOTHING;\n\nINSERT INTO public.orders\n(order_reference, customer_phone, customer_name, product_sku, quantity, total_amount, status)\nVALUES\n('NM-10001', '08000000001', 'John Doe', 'OR-PB-001', 2, 50000, 'PROCESSING'),\n('NM-10002', '08000000002', 'Jane Smith', 'OR-FP-004', 1, 45000, 'SHIPPED'),\n('NM-10003', '08000000003', 'David James', 'SAM-A15-001', 1, 285000, 'DELIVERED')\nON CONFLICT (order_reference) DO NOTHING;",
        "options": {}
