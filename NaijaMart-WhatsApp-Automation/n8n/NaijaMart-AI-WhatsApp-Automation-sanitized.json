      ]
    },
    {
      "parameters": {
        "jsCode": "const aiText = $json.content.parts[0].text;\n\nlet ai;\n\ntry {\n  ai = JSON.parse(aiText);\n} catch (error) {\n  throw new Error(`Gemini returned invalid JSON: ${aiText}`);\n}\n\nreturn {\n  json: {\n    ...$json,\n    ai\n  }\n};"
      },
